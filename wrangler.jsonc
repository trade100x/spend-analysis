{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spend-analysis",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "moneyflow.crazyidea.fun", "custom_domain": true }
  ],
  "triggers": { "crons": ["0 5 * * *"] },
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "56bbbc16a6224580baf2143432e87e5d" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "spend-analysis", "database_id": "557bf830-fb8e-4a49-8c41-49728fdcd03b" }
  ]
}
