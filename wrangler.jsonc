{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spend-analysis",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": { "crons": ["0 5 * * *"] },
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "56bbbc16a6224580baf2143432e87e5d" }
  ]
}
